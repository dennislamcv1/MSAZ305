<mxfile host="drawio" agent="architecture-generator" version="24.0.0"><diagram name="Trade Compliance Architecture" id="arch"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2420" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b&gt;Trade Compliance Monitoring Platform — End-to-End Architecture&lt;/b&gt; &lt;span style=&quot;font-size:20px;color:#605E5C&quot;&gt;(Microsoft Foundry multi-agent · EU + US)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;fontColor=#201F1E;fontStyle=0;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="3240" height="44" as="geometry"/></mxCell><mxCell id="v2" value="200,000 transactions/day · two self-contained regional stacks · 99.9% availability · MiFID II · EMIR · Dodd-Frank · GDPR · EU AI Act (high-risk) · a human compliance officer reviews every flagged case before any report is filed; routine T+1 reports auto-file" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#3B3A39;fontStyle=0;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="3240" height="26" as="geometry"/></mxCell><mxCell id="v3" value="&lt;b style=&quot;font-size:18px&quot;&gt;EU REGION — DATA RESIDENCY BOUNDARY&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:13px;color:#201F1E&quot;&gt;Primary: &lt;b&gt;Sweden Central&lt;/b&gt; (3 availability zones, active) · Standby: &lt;b&gt;Germany West Central&lt;/b&gt; (warm, in-geography) · Foundry &lt;b&gt;Data Zone EU&lt;/b&gt; only · failover never leaves the EU · own subscription, VNets, keys and logs&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#0F4C9A;strokeColor=#0F4C9A;fillColor=#F4F8FE;strokeWidth=3;dashed=1;dashPattern=10 5;spacingTop=10;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="2600" height="1200" as="geometry"/></mxCell><mxCell id="v4" value="&lt;b style=&quot;font-size:13px&quot;&gt;Application Gateway WAF v2&lt;/b&gt;&lt;br&gt;Private frontend (ExpressRoute) · OWASP DRS 2.1 prevention · bot rules · TLS 1.2+ · zone-redundant" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=12;fontColor=#201F1E;strokeColor=#A4262C;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="240" width="270" height="95" as="geometry"/></mxCell><mxCell id="v5" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/networking/Application_Gateways.svg;" vertex="1" parent="1"><mxGeometry x="329" y="248" width="30" height="30" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b style=&quot;font-size:13px&quot;&gt;API Management Premium&lt;/b&gt;&lt;br&gt;Unified AI + MCP gateway (internal VNet)&lt;br&gt;• validate-jwt (Entra) · mTLS producers&lt;br&gt;• validate-content (tcm JSON Schema)&lt;br&gt;• geo-pinning: non-EU entity → HTTP 421&lt;br&gt;• llm-token-limit · rate-limit-by-key&lt;br&gt;• llm-content-safety (Prompt Shields)&lt;br&gt;• llm-emit-token-metric (cost by agent/BU)&lt;br&gt;• backend pools + circuit breaker&lt;br&gt;• MCP registry (pinned tool hashes)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=12;fontColor=#201F1E;strokeColor=#0078D4;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="355" width="270" height="235" as="geometry"/></mxCell><mxCell id="v7" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/app_services/API_Management_Services.svg;" vertex="1" parent="1"><mxGeometry x="329" y="363" width="30" height="30" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b style=&quot;font-size:13px&quot;&gt;Service Bus Premium&lt;/b&gt;&lt;br&gt;Intake queue · session = correlation_id · DLQ · in-geography DR" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=12;fontColor=#201F1E;strokeColor=#5C5C5C;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="610" width="270" height="80" as="geometry"/></mxCell><mxCell id="v9" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/integration/Service_Bus.svg;" vertex="1" parent="1"><mxGeometry x="329" y="618" width="30" height="30" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b style=&quot;font-size:13px&quot;&gt;PII Tokenization Service&lt;/b&gt;&lt;br&gt;Names, client IDs, accounts → HMAC-SHA256 tokens before any agent sees data · keys in Managed HSM" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=12;fontColor=#201F1E;strokeColor=#A4262C;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="710" width="270" height="100" as="geometry"/></mxCell><mxCell id="v11" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/other/Container_App_Environments.svg;" vertex="1" parent="1"><mxGeometry x="329" y="718" width="30" height="30" as="geometry"/></mxCell><mxCell id="v12" value="L1" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.22;fixedSize=0;html=1;fillColor=#A4262C;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="548" y="229" width="32" height="22" as="geometry"/></mxCell><mxCell id="v13" value="O1" style="ellipse;html=1;fillColor=#00897B;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="554" y="342" width="26" height="26" as="geometry"/></mxCell><mxCell id="v14" value="L1" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.22;fixedSize=0;html=1;fillColor=#A4262C;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="516" y="344" width="32" height="22" as="geometry"/></mxCell><mxCell id="v15" value="PE" style="rounded=1;arcSize=40;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#0B5A0B;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="680" width="32" height="18" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=none;html=1;rounded=0;jumpStyle=arc;jumpSize=10;strokeColor=#201F1E;strokeWidth=2;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="v4" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=none;html=1;rounded=0;jumpStyle=arc;jumpSize=10;strokeColor=#201F1E;strokeWidth=2;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="v6" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=none;html=1;rounded=0;jumpStyle=arc;jumpSize=10;strokeColor=#201F1E;strokeWidth=2;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="v8" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v19" value="FOUNDRY WORKFLOWS&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;Foundry Agent Service&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#0078D4;strokeColor=#0078D4;fillColor=#E9F3FC;strokeWidth=2;spacingLeft=46;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="240" width="420" height="570" as="geometry"/></mxCell><mxCell id="v20" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/ai_machine_learning/Foundry_Agent_Service.svg;" vertex="1" parent="1"><mxGeometry x="659" y="247" width="30" height="30" as="geometry"/></mxCell><mxCell id="v21" value="PE" style="rounded=1;arcSize=40;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#0B5A0B;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="800" width="32" height="18" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b style=&quot;font-size:16px&quot;&gt;ORCHESTRATOR AGENT&lt;/b&gt;&lt;br&gt;• Foundry Agent Service hosted agent · own Entra Agent ID&lt;br&gt;• Assigns correlation_id TCM-EU-{yyyymmdd}-{ULID}&lt;br&gt;• Tools: &lt;b&gt;fiq-regulatory&lt;/b&gt; · &lt;b&gt;fiq-internal-policy&lt;/b&gt; (Foundry IQ) · &lt;b&gt;mcp-regfeed&lt;/b&gt; · &lt;b&gt;mcp-sanctions-lists&lt;/b&gt; · &lt;b&gt;mcp-casemgmt&lt;/b&gt; (MCP)&lt;br&gt;• Calls 5 specialists as A2A connected agents&lt;br&gt;• Aggregates typed findings · writes reviewer narrative (grounded, cited)&lt;br&gt;• Fresh thread per transaction — no cross-trade memory; state in Cosmos DB (EU, TTL)&lt;br&gt;• Has &lt;b&gt;no filing tool&lt;/b&gt; — cannot file flagged reports&lt;br&gt;• Single audit writer (event-sourced)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=12.5;fontColor=#201F1E;strokeColor=#0078D4;fillColor=#FFFFFF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="670" y="285" width="380" height="300" as="geometry"/></mxCell><mxCell id="v23" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/ai_machine_learning/Foundry_Agent_Service.svg;" vertex="1" parent="1"><mxGeometry x="679" y="293" width="30" height="30" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b style=&quot;font-size:12px&quot;&gt;Jurisdiction router&lt;/b&gt;&lt;br&gt;deterministic · EU venue/entity → MiFID II · EU OTC derivative → EMIR · US-person swap → Dodd-Frank" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=10;fontColor=#201F1E;strokeColor=#5C5C5C;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670" y="600" width="185" height="85" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b style=&quot;font-size:12px&quot;&gt;Escalation policy gate&lt;/b&gt;&lt;br&gt;versioned rules: risk ≥ 70 · sanctions ≥ 0.85 · STOR signal · INDETERMINATE · agent disagreement" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=10;fontColor=#201F1E;strokeColor=#5C5C5C;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="865" y="600" width="185" height="85" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b style=&quot;font-size:12px;color:#C50F1F&quot;&gt;HITL CHECKPOINT&lt;/b&gt;&lt;br&gt;workflow pauses until a signed reviewer decision arrives · no auto-approve on timeout" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=10;fontColor=#201F1E;strokeColor=#C50F1F;fillColor=#FFF5F5;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="670" y="700" width="185" height="95" as="geometry"/></mxCell><mxCell id="v27" value="&lt;b style=&quot;font-size:12px;color:#107C10&quot;&gt;Routine T+1 path&lt;/b&gt;&lt;br&gt;unflagged, fully validated reports → reporting gateway (auto-file)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;fontSize=10;fontColor=#201F1E;strokeColor=#107C10;fillColor=#F3FBF2;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="865" y="700" width="185" height="95" as="geometry"/></mxCell><mxCell id="v28" value="O2" style="ellipse;html=1;fillColor=#00897B;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="904" y="272" width="26" height="26" as="geometry"/></mxCell><mxCell id="v29" value="L3" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.22;fixedSize=0;html=1;fillColor=#A4262C;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="866" y="274" width="32" height="22" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=none;html=1;rounded=0;jumpStyle=arc;jumpSize=10;strokeColor=#201F1E;strokeWidth=2;endArrow=block;endFill=1;endSize=6;startArrow=none;startFill=1;startSize=6;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.3500;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="v10" target="v22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="612" y="760.0"/><mxPoint x="612" y="390"/></Array></mxGeometry></mxCell><mxCell id="v31" value="SPECIALIST AGENTS&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px&quot;&gt;A2A · typed handoff tcm.handoff.v1 · least-privilege fields&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#0078D4;strokeColor=#0078D4;fillColor=#E9F3FC;strokeWidth=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="240" width="360" height="570" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;&lt;span style=&quot;color:#0078D4&quot;&gt;①&lt;/span&gt; MiFID II Rule Checking Agent&lt;/b&gt;&lt;br&gt;RTS 22 (65 fields) · reportability · RTS 25 time · STOR signals · kb-mifid2-mifir" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=11;fontColor=#201F1E;strokeColor=#0078D4;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1158" y="288" width="324" height="86" as="geometry"/></mxCell><mxCell id="v33" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/ai_machine_learning/Foundry_Agent_Service.svg;" vertex="1" parent="1"><mxGeometry x="1167" y="296" width="30" height="30" as="geometry"/></mxCell><mxCell id="v34" value="O3" style="ellipse;html=1;fillColor=#00897B;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1446" y="275" width="26" height="26" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;&lt;span style=&quot;color:#0078D4&quot;&gt;①&lt;/span&gt; EMIR Rule Checking Agent&lt;/b&gt;&lt;br&gt;REFIT T+1 · UTI/UPI · FC/NFC classification · clearing · kb-emir-refit" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=11;fontColor=#201F1E;strokeColor=