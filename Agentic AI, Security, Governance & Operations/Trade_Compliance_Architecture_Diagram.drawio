ning Agent&lt;/b&gt;&lt;br&gt;fuzzy-match adjudication vs cached EU/UN/UK/OFAC lists · fail-closed" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=11;fontColor=#201F1E;strokeColor=#0078D4;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1158" y="579" width="324" height="86" as="geometry"/></mxCell><mxCell id="v42" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/ai_machine_learning/Foundry_Agent_Service.svg;" vertex="1" parent="1"><mxGeometry x="1167" y="587" width="30" height="30" as="geometry"/></mxCell><mxCell id="v43" value="O3" style="ellipse;html=1;fillColor=#00897B;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1446" y="566" width="26" height="26" as="geometry"/></mxCell><mxCell id="v44" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;&lt;span style=&quot;color:#0078D4&quot;&gt;②&lt;/span&gt; Risk Scoring Agent&lt;/b&gt;&lt;br&gt;0–100 score + top-5 drivers via risk-model endpoint · kb-internal-policy" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=11;fontColor=#201F1E;strokeColor=#0078D4;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1158" y="676" width="324" height="86" as="geometry"/></mxCell><mxCell id="v45" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/ai_machine_learning/Foundry_Agent_Service.svg;" vertex="1" parent="1"><mxGeometry x="1167" y="684" width="30" height="30" as="geometry"/></mxCell><mxCell id="v46" value="O3" style="ellipse;html=1;fillColor=#00897B;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle