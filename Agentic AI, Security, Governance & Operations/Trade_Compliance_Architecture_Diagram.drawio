=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#6B3FA0;strokeColor=#6B3FA0;fillColor=#F7F2FC;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="290" y="1345" width="2600" height="205" as="geometry"/></mxCell><mxCell id="v277" value="&lt;b style=&quot;font-size:15px;color:#6B3FA0&quot;&gt;GLOBAL CONTROL PLANE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px&quot;&gt;identity · policy · release · security governance&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#C50F1F&quot;&gt;&lt;b&gt;Residency rule:&lt;/b&gt; no transaction or personal data crosses EU ↔ US through this plane — only policy assignments, signed release artefacts and aggregated non-PII metrics.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#201F1E;fontStyle=0;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="305" y="1355" width="290" height="185" as="geometry"/></mxCell><mxCell id="v278" value="&lt;b style=&quot;font-size:13px&quot;&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;Entra Agent ID per agent · managed identities · PIM just-in-time · Conditional Access · OIDC workload federation for CI/CD (no secrets)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=11.5;fontColor=#201F1E;strokeColor=#6B3FA0;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="610" y="1380" width="367" height="155" as="geometry"/></mxCell><mxCell id="v279" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/other/Entra_Identity.svg;" vertex="1" parent="1"><mxGeometry x="619" y="1388" width="30" height="30" as="geometry"/></mxCell><mxCell id="v280" value="&lt;b style=&quot;font-size:13px&quot;&gt;Azure Policy&lt;/b&gt;&lt;br&gt;&lt;b&gt;GDPR-Data-Residency&lt;/b&gt; (allowed locations, deny Global SKUs) · &lt;b&gt;EU-AI-Act-HighRisk&lt;/b&gt; (required tags, guardrail policy, Art. 12 logging) · &lt;b&gt;Approved-Model-List&lt;/b&gt; · deny public access &amp;amp; key auth" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=11.5;fontColor=#201F1E;strokeColor=#6B3FA0;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="989" y="1380" width="367" height="155" as="geometry"/></mxCell><mxCell id="v281" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="1"><mxGeometry x="998" y="1388" width="30" height="30" as="geometry"/></mxCell><mxCell id="v282" value="&lt;b style=&quot;font-size:13px&quot;&gt;CI/CD pipeline&lt;/b&gt;&lt;br&gt;Build &amp;amp; supply-chain checks → &lt;b&gt;evaluation gate&lt;/b&gt; → &lt;b&gt;safety gate&lt;/b&gt; → &lt;b&gt;conformity gate&lt;/b&gt; → blue/green release · dev → test → prod per geography" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=11.5;fontColor=#201F1E;strokeColor=#6B3FA0;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1368" y="1380" width="367" height="155" as="geometry"/></mxCell><mxCell id="v283" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/devops/Azure_DevOps.svg;" vertex="1" parent="1"><mxGeometry x="1377" y="1388" width="30" height="30" as="geometry"/></mxCell><mxCell id="v284" value="&lt;b style=&quot;font-size:13px&quot;&gt;Purview + Compliance Manager&lt;/b&gt;&lt;br&gt;Data map &amp;amp; classification · EU AI Act Annex IV technical file · DPIA · conformity evidence versioned per release" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpa