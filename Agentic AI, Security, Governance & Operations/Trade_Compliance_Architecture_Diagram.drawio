1" parent="1"><mxGeometry x="2477" y="792" width="32" height="18" as="geometry"/></mxCell><mxCell id="v97" value="PE" style="rounded=1;arcSize=40;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#0B5A0B;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2700" y="792" width="32" height="18" as="geometry"/></mxCell><mxCell id="v98" value="O6" style="ellipse;html=1;fillColor=#00897B;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2704" y="557" width="26" height="26" as="geometry"/></mxCell><mxCell id="v99" value="AZURE FIREWALL PREMIUM — EGRESS&amp;nbsp;·&amp;nbsp; FQDN allowlist · TLS inspection · IDPS · UDR-forced" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;horizontal=0;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#A4262C;strokeColor=#A4262C;fillColor=#FDF3F3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2790" y="240" width="80" height="815" as="geometry"/></mxCell><mxCell id="v100" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/networking/Firewalls.svg;" vertex="1" parent="1"><mxGeometry x="2813" y="248" width="34" height="34" as="geometry"/></mxCell><mxCell id="v101" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Reviewer portal ingress&lt;/b&gt;&lt;br&gt;App Gateway WAF listener · Entra ID pre-auth · Conditional Access (phishing-resistant MFA)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=11;fontColor=#201F1E;strokeColor=#A4262C;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="885" width="270" height="95" as="geometry"/></mxCell><mxCell id="v102" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/networking/Web_Application_Firewall_Policies_WAF.svg;" vertex="1" parent="1"><mxGeometry x="329" y="893" width="30" height="30" as="geometry"/></mxCell><mxCell id="v103" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;&lt;span style=&quot;color:#C50F1F&quot;&gt;HUMAN COMPLIANCE OFFICER REVIEW QUEUE&lt;/span&gt;&lt;/b&gt;&lt;br&gt;Case management system (via mcp-casemgmt) + Service Bus review queue&lt;br&gt;• Package: findings + citations, score drivers, sanctions match detail, T+1 timer&lt;br&gt;• Decision: approve-file / reject / escalate-MLRO + reason code, Key Vault-signed&lt;br&gt;• Four-eyes for STOR &amp;amp; sanctions · SLA 4 business hours · auto-escalate before cut-off" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=11.5;fontColor=#201F1E;strokeColor=#C50F1F;fillColor=#FFF5F5;strokeWidth=3.5;" vertex="1" parent="1"><mxGeometry x="650" y="875" width="420" height="180" as="geometry"/></mxCell><mxCell id="v104" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/identity/Users.svg;" vertex="1" parent="1"><mxGeometry x="659" y="883" width="30" height="30" as="geometry"/></mxCell><mxCell id="v105" value="&lt;b style=&quot;font-size:13px&quot;&gt;Managed Online Endpoints (blue / green)&lt;/b&gt;&lt;br&gt;Deterministic rules engine (fallback for rule agents) · risk-scoring model (validated) · 3–12 instances across AZs · autoscale on CPU / p95 · traffic split + 10% mirror" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=12;fontColor=#201F1E;strokeColor=#0078D4;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1140" y="875" width="360" height="180" as="geometry"/></mxCell><mxCell id="v106" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/ai_machine_learning/Azure_Machine_Learning.svg;" vertex="1" parent="1"><mxGeometry x="1149" y="883" width="30" height="30" as="geometry"/></mxCell><mxCell id="v107" value="&lt;b style=&quot;font-size:13px&quot;&gt;Private networking (hub-spoke)&lt;/b&gt;&lt;br&gt;ExpressRoute gateway · Private DNS Resolver · private-endpoint subnet + private DNS zones · public network access disabled on every PaaS service · UDRs force egress through the firewall · no VNet peering with the US stack" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=12;fontColor=#201F1E;strokeColor=#107C10;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1570" y="875" width="420" height="180" as="geometry"/></mxCell><mxCell id="v108" value="" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=img/lib/azure2/networking/Private_Endpoint.svg;" vertex="1" parent="1"><mxGeometry x="1579" y="883" width="30" height="30" as="geometry"/></mxCell><mxCell id="v109" value="&lt;b style=&quot;font-size:13px&quot;&gt;Regulatory Reporting Gateway — workflow step, NOT an agent tool&lt;/b&gt;&lt;br&gt;• Routine T+1 reports auto-filed after deterministic validation&lt;br&gt;• Flagged reports, STORs and amendments require a signed reviewer approval token&lt;br&gt;• ARM → NCA (MiFIR RTS 22) · EMIR trade repository · NCA STOR (MAR Art. 16)&lt;br&gt;• Submission receipts written back to the audit pipeline (report_ref)" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=46;spacingTop=5;spacingRight=6;fontSize=12;fontColor=#201F1E;strokeColor=#5C5C5C;fillColor=#FFFFFF;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2060" y="875" width="700" height="180" as="geometry"/></mxCell><mxCell id="v110